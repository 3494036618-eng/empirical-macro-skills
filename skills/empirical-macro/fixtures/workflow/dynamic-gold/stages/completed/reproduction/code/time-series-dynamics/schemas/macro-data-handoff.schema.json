{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:time-series-dynamics:macro-data-handoff:0.1.0",
  "title": "macro-data to time-series-dynamics handoff",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "research_use",
    "execution_status",
    "research_readiness",
    "delivery_eligibility",
    "eligible_for_estimation",
    "review_required",
    "frequency",
    "observation_period",
    "source_checksum",
    "source",
    "variables",
    "provenance_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0-beta"
    },
    "result_id": {
      "type": "string",
      "pattern": "^macro-result-[a-f0-9]{16,64}$"
    },
    "research_use": {
      "const": "dynamic_response"
    },
    "execution_status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "research_readiness": {
      "enum": [
        "ready",
        "review_required",
        "blocked"
      ]
    },
    "delivery_eligibility": {
      "enum": [
        "analysis_ready",
        "comparison_only",
        "not_deliverable"
      ]
    },
    "eligible_for_estimation": {
      "type": "boolean"
    },
    "review_required": {
      "type": "boolean"
    },
    "frequency": {
      "const": "Q"
    },
    "observation_period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "end": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        }
      },
      "additionalProperties": false
    },
    "source_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "dataset",
        "version",
        "license"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "provenance_complete": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery_eligibility": {
            "const": "analysis_ready"
          }
        },
        "required": [
          "delivery_eligibility"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "success"
          },
          "research_readiness": {
            "const": "ready"
          },
          "eligible_for_estimation": {
            "const": true
          },
          "review_required": {
            "const": false
          },
          "provenance_complete": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "eligible_for_estimation": {
            "const": false
          },
          "review_required": {
            "const": true
          }
        }
      }
    }
  ]
}
