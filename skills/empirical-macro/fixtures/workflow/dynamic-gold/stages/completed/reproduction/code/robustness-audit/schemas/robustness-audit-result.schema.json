{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:robustness-audit:result:0.1.0",
  "title": "robustness-audit result",
  "type": "object",
  "required": [
    "schema_version",
    "audit_result_id",
    "audit_plan_ref",
    "baseline_request_ref",
    "plan_timing",
    "execution_status",
    "audit_readiness",
    "assessment",
    "release_recommendation",
    "claim_eligibility",
    "causal_language_allowed",
    "required_check_count",
    "completed_required_check_count",
    "check_result_refs",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "audit_result_id": {
      "type": "string",
      "pattern": "^ra-result-[a-f0-9]{32,64}$"
    },
    "audit_plan_ref": {
      "type": "string",
      "pattern": "^ra-plan-[a-f0-9]{32,64}$"
    },
    "baseline_request_ref": {
      "type": "string",
      "pattern": "^tsd-request-[a-f0-9]{16,64}$"
    },
    "plan_timing": {
      "enum": ["pre_result_bound", "post_result_exploratory", "unknown"]
    },
    "execution_status": {"enum": ["success", "partial", "failed"]},
    "audit_readiness": {"enum": ["ready", "review_required", "blocked"]},
    "assessment": {
      "enum": [
        "passed_declared_checks",
        "sensitive",
        "inconclusive",
        "not_assessed"
      ]
    },
    "release_recommendation": {
      "enum": ["proceed_with_caveats", "review_required", "stop_ship"]
    },
    "claim_eligibility": {
      "enum": ["causal_candidate", "associational_only"]
    },
    "causal_language_allowed": {"type": "boolean"},
    "required_check_count": {"type": "integer", "minimum": 0},
    "completed_required_check_count": {"type": "integer", "minimum": 0},
    "check_result_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ra-check-result-[a-f0-9]{32,64}$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"execution_status": {"const": "failed"}},
        "required": ["execution_status"]
      },
      "then": {
        "properties": {
          "assessment": {"const": "not_assessed"},
          "release_recommendation": {"const": "stop_ship"},
          "audit_readiness": {"const": "blocked"}
        }
      }
    },
    {
      "if": {
        "properties": {"plan_timing": {"const": "post_result_exploratory"}},
        "required": ["plan_timing"]
      },
      "then": {
        "properties": {
          "release_recommendation": {
            "enum": ["review_required", "stop_ship"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"claim_eligibility": {"const": "associational_only"}},
        "required": ["claim_eligibility"]
      },
      "then": {
        "properties": {"causal_language_allowed": {"const": false}}
      }
    }
  ]
}
