{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:robustness-audit:adapter-capability:0.1.0",
  "title": "robustness-audit adapter capability",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "estimator_contract_version",
    "supported_analysis_tracks",
    "supported_patch_fields",
    "estimand_fields",
    "unsupported_check_families",
    "max_variants",
    "runtime_requirements"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "estimator_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "supported_analysis_tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identified_shock_irf",
          "conditional_dynamic_association"
        ]
      }
    },
    "supported_patch_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{1,63}$"}
    },
    "estimand_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "unsupported_check_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "max_variants": {"type": "integer", "minimum": 1, "maximum": 32},
    "runtime_requirements": {
      "type": "object",
      "required": ["runner", "run_script", "validate_script"],
      "properties": {
        "runner": {"const": "uv"},
        "run_script": {"type": "string", "minLength": 1, "maxLength": 200},
        "validate_script": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
