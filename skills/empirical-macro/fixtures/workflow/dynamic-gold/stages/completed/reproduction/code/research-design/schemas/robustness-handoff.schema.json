{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-design:robustness-handoff:0.1.0-draft",
  "title": "research-design robustness handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "research_plan_ref",
    "identification_audit_ref",
    "estimand_components",
    "estimand_fingerprint",
    "analysis_track",
    "claim_eligibility",
    "assumptions",
    "threats",
    "required_diagnostics",
    "declared_checks",
    "allowed_patch_fields",
    "forbidden_patch_fields",
    "review_required",
    "provenance_complete",
    "checksum"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-draft"},
    "handoff_id": {
      "type": "string",
      "pattern": "^rd-robustness-[a-f0-9]{16,64}$"
    },
    "research_plan_ref": {
      "type": "string",
      "pattern": "^research-plan-[a-f0-9]{16,64}$"
    },
    "identification_audit_ref": {
      "type": ["string", "null"],
      "pattern": "^id-audit-[a-f0-9]{16,64}$"
    },
    "estimand_components": {
      "type": "object",
      "required": [
        "outcome_variable_id",
        "exposure_variable_id",
        "analysis_track",
        "estimand_type",
        "horizons"
      ],
      "properties": {
        "outcome_variable_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "exposure_variable_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "analysis_track": {
          "enum": [
            "identified_shock_irf",
            "conditional_dynamic_association"
          ]
        },
        "estimand_type": {
          "enum": ["impulse_response", "conditional_projection_path"]
        },
        "horizons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 120}
        }
      },
      "additionalProperties": false
    },
    "estimand_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "analysis_track": {
      "enum": [
        "identified_shock_irf",
        "conditional_dynamic_association"
      ]
    },
    "claim_eligibility": {
      "enum": ["causal_candidate", "associational_only"]
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    },
    "threats": {
      "type": "array",
      "items": {"$ref": "#/$defs/threat"}
    },
    "required_diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "declared_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/declared_check"}
    },
    "allowed_patch_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "forbidden_patch_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "review_required": {"type": "boolean"},
    "provenance_complete": {"const": true},
    "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"claim_eligibility": {"const": "causal_candidate"}},
        "required": ["claim_eligibility"]
      },
      "then": {
        "properties": {
          "identification_audit_ref": {"type": "string"},
          "review_required": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "assumption": {
      "type": "object",
      "required": ["code", "status", "required_diagnostics"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "status": {
          "enum": ["asserted", "supported", "violated", "unresolved", "not_applicable"]
        },
        "required_diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        }
      },
      "additionalProperties": false
    },
    "threat": {
      "type": "object",
      "required": ["code", "severity", "status"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "severity": {"enum": ["low", "medium", "high", "stop_ship"]},
        "status": {"enum": ["open", "mitigated", "accepted", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "declared_check": {
      "type": "object",
      "required": [
        "check_family",
        "required",
        "patches",
        "anchor_horizons",
        "metrics",
        "decision_rules",
        "threat_refs",
        "diagnostic_refs"
      ],
      "properties": {
        "check_family": {
          "enum": [
            "exact_rerun",
            "lag_sensitivity",
            "covariance_sensitivity",
            "sample_policy_sensitivity",
            "sample_window_sensitivity"
          ]
        },
        "required": {"type": "boolean"},
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object", "additionalProperties": true}
        },
        "anchor_horizons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 120}
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        },
        "decision_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        },
        "threat_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        },
        "diagnostic_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {"properties": {"threat_refs": {"minItems": 1}}},
        {"properties": {"diagnostic_refs": {"minItems": 1}}}
      ]
    }
  }
}
