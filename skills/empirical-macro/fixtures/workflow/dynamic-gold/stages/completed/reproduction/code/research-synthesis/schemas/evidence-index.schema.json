{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-synthesis:evidence-index:0.1.0",
  "title": "research-synthesis evidence index",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_index_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "evidence_index_id": {
      "type": "string",
      "pattern": "^rs-evidence-index-[a-f0-9]{32}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "evidence_class",
          "semantic_role",
          "artifact_path",
          "artifact_sha256",
          "locator",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^rs-evidence-[a-f0-9]{32}$"
          },
          "evidence_class": {
            "enum": [
              "project_evidence",
              "methodological_source",
              "external_context"
            ]
          },
          "semantic_role": {
            "enum": [
              "research_question",
              "estimand",
              "identification",
              "data_identity",
              "data_quality",
              "estimate",
              "uncertainty",
              "diagnostic",
              "robustness_check",
              "assessment",
              "limitation",
              "license",
              "runtime",
              "reproduction_step",
              "external_method",
              "external_context"
            ]
          },
          "artifact_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^*?]+$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "locator": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "json_pointer",
                  "csv_row_key",
                  "file"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "status": {
            "const": "verified"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
