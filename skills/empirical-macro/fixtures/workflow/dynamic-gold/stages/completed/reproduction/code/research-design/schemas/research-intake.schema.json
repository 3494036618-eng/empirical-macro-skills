{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-design:intake:0.1.0-draft",
  "title": "research-design guided intake",
  "type": "object",
  "required": [
    "schema_version",
    "intake_id",
    "raw_user_input",
    "input_maturity",
    "candidate_questions",
    "recommended_candidate_id",
    "field_provenance",
    "clarifications",
    "safe_default",
    "status",
    "output_language"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-draft"},
    "intake_id": {
      "type": "string",
      "pattern": "^rd-intake-[a-f0-9]{16,64}$"
    },
    "raw_user_input": {
      "type": "string",
      "minLength": 3,
      "maxLength": 5000
    },
    "input_maturity": {
      "enum": ["idea_only", "question_ready", "design_ready", "execution_ready"]
    },
    "candidate_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "recommended_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^rd-candidate-[a-f0-9]{8,64}$"
    },
    "field_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "clarifications": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/clarification"}
    },
    "safe_default": {
      "type": "object",
      "required": ["applied", "downgraded_to", "reason"],
      "properties": {
        "applied": {"type": "boolean"},
        "downgraded_to": {
          "enum": ["descriptive", "associational", "none"]
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["candidate_set", "clarification_needed", "ready_to_compile", "blocked"]
    },
    "output_language": {"enum": ["zh-CN", "en"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"input_maturity": {"const": "idea_only"}},
        "required": ["input_maturity"]
      },
      "then": {
        "properties": {"candidate_questions": {"minItems": 2}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "clarification_needed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "clarifications": {
            "minItems": 1,
            "contains": {
              "properties": {"status": {"const": "pending"}},
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "ready_to_compile"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recommended_candidate_id": {"type": "string"},
          "clarifications": {
            "not": {
              "contains": {
                "properties": {"status": {"const": "pending"}},
                "required": ["status"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safe_default": {
            "properties": {"applied": {"const": true}},
            "required": ["applied"]
          }
        },
        "required": ["safe_default"]
      },
      "then": {
        "properties": {
          "safe_default": {
            "properties": {
              "downgraded_to": {
                "enum": ["descriptive", "associational"]
              },
              "reason": {"type": "string"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "safe_default": {
            "properties": {
              "downgraded_to": {"const": "none"},
              "reason": {"type": "null"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "research_question",
        "intended_claim_candidate",
        "research_family_candidate",
        "plain_language_explanation",
        "risk_level",
        "locked_user_fields",
        "unresolved_decisions"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^rd-candidate-[a-f0-9]{8,64}$"
        },
        "research_question": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000
        },
        "intended_claim_candidate": {
          "enum": ["descriptive", "associational", "causal", "predictive", "structural"]
        },
        "research_family_candidate": {
          "enum": [
            "descriptive_measurement",
            "panel_association",
            "dynamic_shock_response",
            "causal_policy_evaluation",
            "forecasting_nowcasting",
            "structural_modeling"
          ]
        },
        "plain_language_explanation": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "risk_level": {"enum": ["low", "medium", "high"]},
        "locked_user_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "unresolved_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["field_path", "source", "evidence_text", "confidence"],
      "properties": {
        "field_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.\\[\\]-]{0,127}$"
        },
        "source": {
          "enum": [
            "user_provided",
            "inferred_from_text",
            "recommended_default",
            "unresolved"
          ]
        },
        "evidence_text": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "confidence": {
          "enum": ["high", "medium", "low", "not_applicable"]
        }
      },
      "additionalProperties": false
    },
    "clarification": {
      "type": "object",
      "required": ["question_id", "prompt", "decision_impact", "status", "answer"],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^clarify-[a-f0-9]{8,64}$"
        },
        "prompt": {"type": "string", "minLength": 5, "maxLength": 1000},
        "decision_impact": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "status": {
          "enum": ["pending", "answered", "declined", "not_needed"]
        },
        "answer": {"type": ["string", "null"], "maxLength": 2000}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "answered"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"answer": {"type": "string", "minLength": 1}}
          },
          "else": {
            "properties": {"answer": {"type": "null"}}
          }
        }
      ]
    }
  }
}
