{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-design:plan:0.1.0-draft",
  "title": "research-design plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "research_family",
    "intended_claim",
    "estimand",
    "primary_design",
    "design_candidates",
    "identification_audit_ref",
    "data_requirements_ref",
    "diagnostics",
    "robustness_checks",
    "reproducibility_requirements",
    "execution_status",
    "design_readiness",
    "claim_eligibility",
    "review_required",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^research-plan-[a-f0-9]{16,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^rd-request-[a-f0-9]{16,64}$"
    },
    "research_family": {
      "enum": [
        "descriptive_measurement",
        "panel_association",
        "dynamic_shock_response",
        "causal_policy_evaluation",
        "forecasting_nowcasting",
        "structural_modeling",
        "undetermined"
      ]
    },
    "intended_claim": {
      "enum": [
        "descriptive",
        "associational",
        "causal",
        "predictive",
        "structural"
      ]
    },
    "analysis_track": {
      "enum": [
        "identified_shock_irf",
        "conditional_dynamic_association",
        "not_applicable"
      ]
    },
    "estimand": {
      "type": "object",
      "required": [
        "type",
        "outcome_variable_id",
        "treatment_or_shock_variable_id",
        "target_population",
        "comparison",
        "horizons",
        "status"
      ],
      "properties": {
        "type": {
          "enum": [
            "descriptive_statistic",
            "association",
            "ate",
            "att",
            "dynamic_response",
            "forecast_target",
            "structural_parameter",
            "unresolved"
          ]
        },
        "outcome_variable_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "treatment_or_shock_variable_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "target_population": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "comparison": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "horizons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          }
        },
        "status": {
          "enum": [
            "specified",
            "partial",
            "missing",
            "not_applicable"
          ]
        }
      },
      "additionalProperties": false
    },
    "primary_design": {
      "enum": [
        "descriptive_trend",
        "cross_sectional_association",
        "panel_fixed_effects",
        "event_study_did",
        "synthetic_control",
        "synthetic_did",
        "instrumental_variables",
        "local_projection",
        "conditional_projection",
        "var_svar",
        "forecast_backtest",
        "nowcast",
        "structural_model",
        "unresolved"
      ]
    },
    "design_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "design",
          "decision",
          "prerequisites",
          "rejection_reasons"
        ],
        "properties": {
          "design": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "decision": {
            "enum": [
              "adopt",
              "controlled_experiment",
              "defer",
              "reject"
            ]
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "rejection_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "additionalProperties": false
      }
    },
    "identification_audit_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^id-audit-[a-f0-9]{16,64}$"
    },
    "data_requirements_ref": {
      "type": "string",
      "pattern": "^data-req-[a-f0-9]{16,64}$"
    },
    "diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "robustness_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "reproducibility_requirements": {
      "type": "object",
      "required": [
        "raw_data_lineage",
        "code_and_environment",
        "fixed_random_seed",
        "artifact_checksums",
        "independent_rerun_required"
      ],
      "properties": {
        "raw_data_lineage": {
          "const": true
        },
        "code_and_environment": {
          "const": true
        },
        "fixed_random_seed": {
          "type": "boolean"
        },
        "artifact_checksums": {
          "const": true
        },
        "independent_rerun_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "execution_status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "design_readiness": {
      "enum": [
        "ready_for_data",
        "review_required",
        "blocked"
      ]
    },
    "claim_eligibility": {
      "enum": [
        "descriptive_only",
        "associational_only",
        "predictive_only",
        "causal_candidate",
        "structural_candidate",
        "not_eligible"
      ]
    },
    "review_required": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "design_readiness": {
            "const": "ready_for_data"
          }
        },
        "required": [
          "design_readiness"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "success"
          },
          "primary_design": {
            "not": {
              "const": "unresolved"
            }
          },
          "review_required": {
            "const": false
          },
          "warnings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_eligibility": {
            "enum": [
              "causal_candidate",
              "structural_candidate"
            ]
          }
        },
        "required": [
          "claim_eligibility"
        ]
      },
      "then": {
        "properties": {
          "identification_audit_ref": {
            "type": "string"
          },
          "review_required": {
            "const": true
          }
        }
      }
    }
  ]
}
