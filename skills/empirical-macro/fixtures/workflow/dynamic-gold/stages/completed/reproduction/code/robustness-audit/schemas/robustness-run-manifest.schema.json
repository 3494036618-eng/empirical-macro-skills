{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:robustness-audit:run-manifest:0.1.0",
  "title": "robustness-audit run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "audit_request_ref",
    "audit_plan_ref",
    "generated_at",
    "runtime",
    "input_checksums",
    "output_checksums",
    "alternative_bundle_checksums",
    "secrets_recorded"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "pattern": "^ra-run-[a-f0-9]{32,64}$"},
    "audit_request_ref": {
      "type": "string",
      "pattern": "^ra-request-[a-f0-9]{32,64}$"
    },
    "audit_plan_ref": {
      "type": "string",
      "pattern": "^ra-plan-[a-f0-9]{32,64}$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "required": ["python", "numpy", "pandas", "matplotlib"],
      "properties": {
        "python": {"type": "string", "minLength": 1, "maxLength": 50},
        "numpy": {"type": "string", "minLength": 1, "maxLength": 50},
        "pandas": {"type": "string", "minLength": 1, "maxLength": 50},
        "matplotlib": {"type": "string", "minLength": 1, "maxLength": 50}
      },
      "additionalProperties": false
    },
    "input_checksums": {"$ref": "#/$defs/checksum_map"},
    "output_checksums": {"$ref": "#/$defs/checksum_map"},
    "alternative_bundle_checksums": {"$ref": "#/$defs/checksum_map"},
    "secrets_recorded": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "checksum_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
