{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-synthesis:reproduction-manifest:0.1.0",
  "title": "research-synthesis reproduction manifest",
  "type": "object",
  "required": [
    "schema_version",
    "reproduction_status",
    "steps",
    "expected_outputs",
    "runtime",
    "network_required"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "reproduction_status": {
      "enum": [
        "verified",
        "not_run",
        "failed",
        "not_applicable"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "argv",
          "working_directory",
          "expected_exit_code"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "working_directory": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^*?]+$"
          },
          "expected_exit_code": {
            "const": 0
          }
        },
        "additionalProperties": false
      }
    },
    "expected_outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "network_required": {
      "const": false
    }
  },
  "additionalProperties": false
}
