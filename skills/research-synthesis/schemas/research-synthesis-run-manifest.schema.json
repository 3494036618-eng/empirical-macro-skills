{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-synthesis:run-manifest:0.1.0",
  "title": "research-synthesis run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "request_ref",
    "result_ref",
    "generated_at",
    "runtime",
    "input_checksums",
    "output_checksums",
    "secrets_recorded"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^rs-run-[a-f0-9]{32}$"
    },
    "request_ref": {
      "type": "string",
      "pattern": "^rs-request-[a-f0-9]{32}$"
    },
    "result_ref": {
      "type": "string",
      "pattern": "^rs-result-[a-f0-9]{32}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "input_checksums": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "output_checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "secrets_recorded": {
      "const": false
    }
  },
  "additionalProperties": false
}
