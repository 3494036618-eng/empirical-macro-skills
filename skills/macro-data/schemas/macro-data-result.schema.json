{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:macro-data:result:0.2.0-beta",
  "title": "macro-data result",
  "description": "macro-data 三轴状态、交付资格和关键科研完整性合同。",
  "type": "object",
  "required": [
    "schema_version",
    "research_use",
    "request_manifest",
    "series",
    "raw_artifacts",
    "normalized_artifacts",
    "transformations",
    "missingness",
    "provenance",
    "evidence_references",
    "execution_status",
    "research_readiness",
    "delivery_eligibility",
    "eligible_for_estimation",
    "source_coverage",
    "warnings",
    "review_required"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0-beta"
    },
    "research_use": {
      "enum": [
        "descriptive_latest",
        "panel_analysis",
        "dynamic_response",
        "forecasting",
        "real_time"
      ]
    },
    "result_id": {
      "type": "string",
      "pattern": "^macro-result-[a-f0-9]{16,64}$"
    },
    "frequency": {
      "enum": ["M", "Q"]
    },
    "observation_period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 4, "maxLength": 10},
        "end": {"type": "string", "minLength": 4, "maxLength": 10}
      },
      "additionalProperties": false
    },
    "source_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_use_scope": {
      "enum": [
        "first_party_product_development",
        "internal_research",
        "controlled_public_demo",
        "public_payload_redistribution"
      ]
    },
    "public_payload_policy": {
      "enum": [
        "metadata_only",
        "authorized"
      ]
    },
    "product_authorization_ref": {
      "type": "string",
      "pattern": "^product-auth-[a-f0-9]{32}$"
    },
    "request_manifest": {
      "type": "object"
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "raw_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "normalized_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missingness": {
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "evidence_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "execution_status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "research_readiness": {
      "enum": [
        "ready",
        "review_required",
        "blocked"
      ]
    },
    "delivery_eligibility": {
      "enum": [
        "analysis_ready",
        "comparison_only",
        "not_deliverable"
      ]
    },
    "eligible_for_estimation": {
      "type": "boolean"
    },
    "source_coverage": {
      "type": "object",
      "required": [
        "complete",
        "scope_reduced",
        "requested_count",
        "delivered_count",
        "failures"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "scope_reduced": {
          "const": false
        },
        "requested_count": {
          "type": "integer",
          "minimum": 1
        },
        "delivered_count": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "failures": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "failures": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "$comment": "requested_count 与 delivered_count 的算术关系由确定性验证器检查；Draft 2020-12 不能直接比较两个实例属性的数值。"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "research_readiness": {
              "const": "ready"
            },
            "review_required": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "research_readiness": {
              "enum": [
                "review_required",
                "blocked"
              ]
            },
            "review_required": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "success"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "source_coverage": {
            "properties": {
              "complete": {
                "const": true
              },
              "failures": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series": {
            "contains": {
              "required": [
                "use_authorization"
              ]
            }
          }
        },
        "required": [
          "series"
        ]
      },
      "then": {
        "required": [
          "data_use_scope",
          "public_payload_policy",
          "product_authorization_ref"
        ],
        "properties": {
          "provenance": {
            "required": [
              "authorization_ref",
              "authorization_basis",
              "data_use_scope",
              "public_payload_policy",
              "credentials_recorded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_coverage": {
            "properties": {
              "complete": {
                "const": false
              }
            },
            "required": [
              "complete"
            ]
          }
        },
        "required": [
          "source_coverage"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "enum": [
              "partial",
              "failed"
            ]
          },
          "source_coverage": {
            "properties": {
              "scope_reduced": {
                "const": false
              },
              "failures": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "failed"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "research_readiness": {
            "const": "blocked"
          },
          "delivery_eligibility": {
            "const": "not_deliverable"
          },
          "eligible_for_estimation": {
            "const": false
          },
          "review_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "research_readiness": {
            "const": "blocked"
          }
        },
        "required": [
          "research_readiness"
        ]
      },
      "then": {
        "properties": {
          "delivery_eligibility": {
            "const": "not_deliverable"
          },
          "eligible_for_estimation": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_eligibility": {
            "const": "comparison_only"
          }
        },
        "required": [
          "delivery_eligibility"
        ]
      },
      "then": {
        "properties": {
          "research_readiness": {
            "const": "review_required"
          },
          "eligible_for_estimation": {
            "const": false
          },
          "review_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_eligibility": {
            "const": "not_deliverable"
          }
        },
        "required": [
          "delivery_eligibility"
        ]
      },
      "then": {
        "properties": {
          "eligible_for_estimation": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_eligibility": {
            "const": "analysis_ready"
          }
        },
        "required": [
          "delivery_eligibility"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "success"
          },
          "research_readiness": {
            "const": "ready"
          },
          "eligible_for_estimation": {
            "const": true
          },
          "review_required": {
            "const": false
          },
          "series": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/series"
                },
                {
                  "properties": {
                    "series_identity": {
                      "properties": {
                        "identity_status": {
                          "const": "verified"
                        },
                        "critical_identity_complete": {
                          "const": true
                        }
                      }
                    },
                    "checksum": {
                      "properties": {
                        "raw_sha256": {
                          "$ref": "#/$defs/sha256"
                        },
                        "normalized_sha256": {
                          "$ref": "#/$defs/sha256"
                        }
                      }
                    },
                    "unresolved_conflicts": {
                      "const": 0
                    }
                  },
                  "anyOf": [
                    {
                      "properties": {
                        "license": {
                          "properties": {
                            "use_status": {
                              "const": "allowed"
                            },
                            "allows_requested_use": {
                              "const": true
                            }
                          }
                        }
                      }
                    },
                    {
                      "required": [
                        "use_authorization"
                      ],
                      "properties": {
                        "source": {
                          "properties": {
                            "provider": {
                              "const": "datapro"
                            }
                          }
                        },
                        "use_authorization": {
                          "properties": {
                            "status": {
                              "const": "authorized"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "raw_artifacts": {
            "minItems": 1
          },
          "normalized_artifacts": {
            "minItems": 1
          },
          "provenance": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              },
              {
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "unresolved_links": {
                    "const": 0
                  }
                }
              }
            ]
          },
          "source_coverage": {
            "properties": {
              "complete": {
                "const": true
              },
              "scope_reduced": {
                "const": false
              },
              "failures": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "research_use": {
            "const": "dynamic_response"
          }
        },
        "required": ["research_use"]
      },
      "then": {
        "required": [
          "result_id",
          "frequency",
          "observation_period",
          "source_checksum"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "series_identity",
        "indicator_definition",
        "entity",
        "source",
        "dataset",
        "series_id",
        "frequency",
        "unit",
        "seasonal_adjustment",
        "price_basis",
        "currency",
        "observation_period",
        "retrieved_at",
        "release_date",
        "vintage",
        "license",
        "raw_artifact",
        "normalized_artifact",
        "transformations",
        "missingness",
        "checksum",
        "provenance_ref",
        "unresolved_conflicts",
        "evidence_references",
        "warnings"
      ],
      "properties": {
        "series_identity": {
          "type": "object",
          "required": [
            "identity_id",
            "native_series_id",
            "connector_series_fingerprint",
            "identity_status",
            "critical_identity_complete"
          ],
          "properties": {
            "identity_id": {
              "$ref": "#/$defs/sha256"
            },
            "native_series_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 500
            },
            "connector_series_fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "identity_status": {
              "enum": [
                "verified",
                "partial",
                "ambiguous"
              ]
            },
            "critical_identity_complete": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "indicator_definition": {
          "type": "object",
          "required": [
            "name",
            "code",
            "definition",
            "concept_scheme"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "definition": {
              "type": [
                "string",
                "null"
              ]
            },
            "concept_scheme": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "entity": {
          "type": "object",
          "required": [
            "name",
            "native_code",
            "native_scheme",
            "canonical_code",
            "canonical_scheme",
            "mapping_version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "native_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_scheme": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_scheme": {
              "type": [
                "string",
                "null"
              ]
            },
            "mapping_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": [
            "provider",
            "native_source",
            "source_changed_from_preference"
          ],
          "properties": {
            "provider": {
              "enum": [
                "datapro",
                "imf",
                "world_bank",
                "oecd",
                "bis",
                "fred",
                "eurostat",
                "national",
                "public_research_archive"
              ]
            },
            "native_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_changed_from_preference": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "dataset": {
          "type": "object",
          "required": [
            "id",
            "name",
            "version",
            "dataflow"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "dataflow": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "series_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "D",
            "W",
            "M",
            "Q",
            "A",
            "source_native",
            null
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "seasonal_adjustment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NSA",
            "CA",
            "SA",
            "SCA",
            "source_native",
            null
          ]
        },
        "price_basis": {
          "type": [
            "object",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "observation_period": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "vintage": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "license": {
          "type": "object",
          "required": [
            "id",
            "url",
            "attribution",
            "use_status",
            "allows_requested_use"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "attribution": {
              "type": [
                "string",
                "null"
              ]
            },
            "use_status": {
              "enum": [
                "allowed",
                "restricted",
                "unknown"
              ]
            },
            "allows_requested_use": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "use_authorization": {
          "type": "object",
          "required": [
            "authorization_ref",
            "authorization_basis",
            "scope",
            "status"
          ],
          "properties": {
            "authorization_ref": {
              "type": "string",
              "pattern": "^product-auth-[a-f0-9]{32}$"
            },
            "authorization_basis": {
              "const": "product_owner_directive"
            },
            "scope": {
              "enum": [
                "first_party_product_development",
                "internal_research",
                "controlled_public_demo",
                "public_payload_redistribution"
              ]
            },
            "status": {
              "enum": [
                "authorized",
                "denied",
                "unresolved"
              ]
            }
          },
          "additionalProperties": false
        },
        "raw_artifact": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "normalized_artifact": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "missingness": {
          "type": "object"
        },
        "checksum": {
          "type": "object",
          "required": [
            "raw_sha256",
            "normalized_sha256"
          ],
          "properties": {
            "raw_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "normalized_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "provenance_ref": {
          "$ref": "#/$defs/sha256"
        },
        "unresolved_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:empirical-macro:macro-data:provenance:0.2.0-beta",
      "title": "macro-data provenance",
      "description": "连接请求、原始数据、规范化数据、转换活动和执行软件的 provenance 合同。",
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "generated_at",
        "input_mode",
        "request_artifact",
        "raw_artifacts",
        "normalized_artifacts",
        "activities",
        "checksums",
        "complete",
        "unresolved_links"
      ],
      "properties": {
        "schema_version": {
          "const": "0.2.0-beta"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-f0-9]{16,64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_mode": {
          "enum": [
            "live",
            "sanitized-live-replay",
            "public-artifact-import",
            "synthetic",
            "mock"
          ]
        },
        "request_artifact": {
          "$ref": "#/$defs/path"
        },
        "raw_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "normalized_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "checksums": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/path"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "unresolved_links": {
          "type": "integer",
          "minimum": 0
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^product-auth-[a-f0-9]{32}$"
        },
        "authorization_basis": {
          "const": "product_owner_directive"
        },
        "data_use_scope": {
          "enum": [
            "first_party_product_development",
            "internal_research",
            "controlled_public_demo",
            "public_payload_redistribution"
          ]
        },
        "public_payload_policy": {
          "enum": [
            "metadata_only",
            "authorized"
          ]
        },
        "credentials_recorded": {
          "const": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "raw_artifacts": {
                "minItems": 1
              },
              "normalized_artifacts": {
                "minItems": 1
              },
              "activities": {
                "minItems": 2
              },
              "unresolved_links": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "authorization_ref"
            ]
          },
          "then": {
            "required": [
              "authorization_basis",
              "data_use_scope",
              "public_payload_policy",
              "credentials_recorded"
            ]
          }
        }
      ],
      "$defs": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "software": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "activity": {
          "type": "object",
          "required": [
            "activity_id",
            "type",
            "agent",
            "started_at",
            "ended_at",
            "used",
            "generated",
            "software",
            "parameters"
          ],
          "properties": {
            "activity_id": {
              "type": "string",
              "pattern": "^activity-[a-f0-9]{16,64}$"
            },
            "type": {
              "enum": [
                "retrieve",
                "normalize",
                "transform",
                "package"
              ]
            },
            "agent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            },
            "used": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "generated": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "software": {
              "$ref": "#/$defs/software"
            },
            "parameters": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
