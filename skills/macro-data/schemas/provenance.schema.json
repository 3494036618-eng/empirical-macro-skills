{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:macro-data:provenance:0.2.0-beta",
  "title": "macro-data provenance",
  "description": "连接请求、原始数据、规范化数据、转换活动和执行软件的 provenance 合同。",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "input_mode",
    "request_artifact",
    "raw_artifacts",
    "normalized_artifacts",
    "activities",
    "checksums",
    "complete",
    "unresolved_links"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0-beta"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{16,64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_mode": {
      "enum": [
        "live",
        "sanitized-live-replay",
        "public-artifact-import",
        "synthetic",
        "mock"
      ]
    },
    "request_artifact": {
      "$ref": "#/$defs/path"
    },
    "raw_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "normalized_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "checksums": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "unresolved_links": {
      "type": "integer",
      "minimum": 0
    },
    "authorization_ref": {
      "type": "string",
      "pattern": "^product-auth-[a-f0-9]{32}$"
    },
    "authorization_basis": {
      "const": "product_owner_directive"
    },
    "data_use_scope": {
      "enum": [
        "first_party_product_development",
        "internal_research",
        "controlled_public_demo",
        "public_payload_redistribution"
      ]
    },
    "public_payload_policy": {
      "enum": [
        "metadata_only",
        "authorized"
      ]
    },
    "credentials_recorded": {
      "const": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "raw_artifacts": {
            "minItems": 1
          },
          "normalized_artifacts": {
            "minItems": 1
          },
          "activities": {
            "minItems": 2
          },
          "unresolved_links": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "authorization_ref"
        ]
      },
      "then": {
        "required": [
          "authorization_basis",
          "data_use_scope",
          "public_payload_policy",
          "credentials_recorded"
        ]
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "software": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "activity_id",
        "type",
        "agent",
        "started_at",
        "ended_at",
        "used",
        "generated",
        "software",
        "parameters"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^activity-[a-f0-9]{16,64}$"
        },
        "type": {
          "enum": [
            "retrieve",
            "normalize",
            "transform",
            "package"
          ]
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "generated": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "software": {
          "$ref": "#/$defs/software"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
