{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:macro-data:expected-observation-matrix:0.3.0-beta",
  "title": "ExpectedObservationMatrix",
  "description": "研究请求冻结后生成的完整 observation cell 分母。",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_id",
    "request_id",
    "request_checksum",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0-beta"
    },
    "matrix_id": {
      "type": "string",
      "pattern": "^macro-matrix-[a-f0-9]{32}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^macro-request-[a-f0-9]{32}$"
    },
    "request_checksum": {
      "$ref": "#/$defs/sha256"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "period": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-?Q[1-4]|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$"
    },
    "key": {
      "type": "object",
      "required": [
        "indicator_code",
        "entity_code",
        "period",
        "frequency"
      ],
      "properties": {
        "indicator_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "entity_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "frequency": {
          "enum": [
            "D",
            "W",
            "M",
            "Q",
            "A"
          ]
        }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": [
        "cell_id",
        "key",
        "status"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^macro-cell-[a-f0-9]{32}$"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "status": {
          "enum": [
            "expected",
            "datapro_locked",
            "official_fallback_locked",
            "unresolved",
            "conflicted"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
