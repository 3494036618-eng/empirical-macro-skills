{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:macro-data:completion-manifest:0.3.0-beta",
  "title": "DataPro-first completion manifest",
  "description": "绑定请求矩阵、缺口、retrieval raw、最终 cell 和 provider contribution。",
  "type": "object",
  "required": [
    "schema_version",
    "completion_manifest_id",
    "matrix_id",
    "matrix_checksum",
    "gap_manifest_id",
    "residual_gap_manifest",
    "expected_observation_count",
    "datapro_attempted",
    "datapro_locked_cell_ids",
    "official_fallback_cell_ids",
    "replaced_primary_count",
    "final_estimator_cell_ids",
    "final_estimator_count",
    "residual_gap_count",
    "conflict_count",
    "provider_contribution",
    "retrievals",
    "overlap_validations",
    "issue_codes",
    "completion_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0-beta"
    },
    "completion_manifest_id": {
      "type": "string",
      "pattern": "^macro-completion-[a-f0-9]{32}$"
    },
    "matrix_id": {
      "type": "string",
      "pattern": "^macro-matrix-[a-f0-9]{32}$"
    },
    "matrix_checksum": {
      "$ref": "#/$defs/sha256"
    },
    "gap_manifest_id": {
      "type": "string",
      "pattern": "^macro-gaps-[a-f0-9]{32}$"
    },
    "residual_gap_manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "gap_manifest_id",
        "matrix_id",
        "datapro_locked_cell_ids",
        "gap_cells",
        "official_requests",
        "issue_codes"
      ]
    },
    "expected_observation_count": {
      "type": "integer",
      "minimum": 1
    },
    "datapro_attempted": {
      "type": "boolean"
    },
    "datapro_locked_cell_ids": {
      "$ref": "#/$defs/cell_ids"
    },
    "official_fallback_cell_ids": {
      "$ref": "#/$defs/cell_ids"
    },
    "replaced_primary_count": {
      "const": 0
    },
    "final_estimator_cell_ids": {
      "$ref": "#/$defs/cell_ids"
    },
    "final_estimator_count": {
      "type": "integer",
      "minimum": 0
    },
    "residual_gap_count": {
      "type": "integer",
      "minimum": 0
    },
    "conflict_count": {
      "type": "integer",
      "minimum": 0
    },
    "provider_contribution": {
      "$ref": "#/$defs/provider_contribution"
    },
    "retrievals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/retrieval"
      }
    },
    "overlap_validations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "issue_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "completion_status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "complete"
          }
        },
        "required": [
          "completion_status"
        ]
      },
      "then": {
        "properties": {
          "residual_gap_count": {
            "const": 0
          },
          "conflict_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "datapro_attempted": {
            "const": false
          }
        },
        "required": [
          "datapro_attempted"
        ]
      },
      "then": {
        "properties": {
          "datapro_locked_cell_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "cell_id": {
      "type": "string",
      "pattern": "^macro-cell-[a-f0-9]{32}$"
    },
    "cell_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell_id"
      }
    },
    "retrieval": {
      "type": "object",
      "required": [
        "provider",
        "raw_artifact",
        "raw_checksum"
      ],
      "properties": {
        "provider": {
          "enum": [
            "datapro",
            "imf",
            "world_bank",
            "oecd",
            "bis",
            "fred",
            "eurostat",
            "national"
          ]
        },
        "raw_artifact": {
          "$ref": "#/$defs/path"
        },
        "raw_checksum": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "provider_contribution": {
      "type": "object",
      "required": [
        "classification",
        "datapro_count",
        "official_fallback_count",
        "unresolved_count",
        "datapro_ratio",
        "official_fallback_ratio"
      ],
      "properties": {
        "classification": {
          "enum": [
            "datapro_only",
            "datapro_primary",
            "datapro_assisted",
            "datapro_attempted"
          ]
        },
        "datapro_count": {
          "type": "integer",
          "minimum": 0
        },
        "official_fallback_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "datapro_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "official_fallback_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "classification": {
              "const": "datapro_only"
            },
            "datapro_ratio": {
              "const": 1
            },
            "official_fallback_ratio": {
              "const": 0
            }
          },
          "required": [
            "classification",
            "datapro_ratio",
            "official_fallback_ratio"
          ]
        },
        {
          "properties": {
            "classification": {
              "const": "datapro_primary"
            },
            "datapro_ratio": {
              "minimum": 0.8,
              "exclusiveMaximum": 1
            }
          },
          "required": [
            "classification",
            "datapro_ratio"
          ]
        },
        {
          "properties": {
            "classification": {
              "const": "datapro_assisted"
            },
            "datapro_ratio": {
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 0.8
            }
          },
          "required": [
            "classification",
            "datapro_ratio"
          ]
        },
        {
          "properties": {
            "classification": {
              "const": "datapro_attempted"
            },
            "datapro_ratio": {
              "const": 0
            }
          },
          "required": [
            "classification",
            "datapro_ratio"
          ]
        }
      ]
    }
  }
}
