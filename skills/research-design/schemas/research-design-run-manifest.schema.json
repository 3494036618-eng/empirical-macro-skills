{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-design:run-manifest:0.1.0-draft",
  "title": "research-design run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "artifacts",
    "execution_status",
    "design_readiness",
    "claim_eligibility",
    "review_required",
    "secrets_recorded"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-draft"},
    "run_id": {
      "type": "string",
      "pattern": "^rd-run-[a-f0-9]{32,64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "research_intake",
        "research_request",
        "research_plan",
        "data_requirements",
        "identification_audit"
      ],
      "properties": {
        "research_intake": {"$ref": "#/$defs/artifact"},
        "research_request": {"$ref": "#/$defs/artifact"},
        "research_plan": {"$ref": "#/$defs/artifact"},
        "data_requirements": {"$ref": "#/$defs/artifact"},
        "identification_audit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifact"}
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_status": {
      "enum": ["success", "partial", "failed"]
    },
    "design_readiness": {
      "enum": ["ready_for_data", "review_required", "blocked"]
    },
    "claim_eligibility": {
      "enum": [
        "descriptive_only",
        "associational_only",
        "predictive_only",
        "causal_candidate",
        "structural_candidate",
        "not_eligible"
      ]
    },
    "review_required": {"type": "boolean"},
    "secrets_recorded": {"const": false}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_eligibility": {
            "enum": ["causal_candidate", "structural_candidate"]
          }
        },
        "required": ["claim_eligibility"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "identification_audit": {"$ref": "#/$defs/artifact"}
            }
          },
          "review_required": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_readiness": {"const": "ready_for_data"}
        },
        "required": ["design_readiness"]
      },
      "then": {
        "properties": {
          "execution_status": {"const": "success"},
          "review_required": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "schema_id", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.json$"
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
