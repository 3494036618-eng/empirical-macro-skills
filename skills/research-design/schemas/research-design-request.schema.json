{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:research-design:request:0.1.0-draft",
  "title": "research-design request",
  "type": "object",
  "required": [
    "schema_version",
    "source_intake_id",
    "selected_candidate_id",
    "request_id",
    "research_question",
    "input_maturity",
    "intended_claim",
    "target_population",
    "unit_of_analysis",
    "time_scope",
    "variables",
    "intervention_or_shock",
    "forecast",
    "field_provenance",
    "unresolved_decisions",
    "safe_downgrade_applied",
    "output_language"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "source_intake_id": {
      "type": "string",
      "pattern": "^rd-intake-[a-f0-9]{16,64}$"
    },
    "selected_candidate_id": {
      "type": "string",
      "pattern": "^rd-candidate-[a-f0-9]{8,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^rd-request-[a-f0-9]{16,64}$"
    },
    "research_question": {
      "type": "string",
      "minLength": 10,
      "maxLength": 3000
    },
    "input_maturity": {
      "enum": [
        "idea_only",
        "question_ready",
        "design_ready",
        "execution_ready"
      ]
    },
    "intended_claim": {
      "enum": [
        "descriptive",
        "associational",
        "causal",
        "predictive",
        "structural"
      ]
    },
    "preferred_design": {
      "enum": [
        "descriptive_trend",
        "panel_fixed_effects",
        "event_study_did",
        "instrumental_variables",
        "local_projection",
        "conditional_projection",
        "var_svar",
        "forecast_backtest",
        "nowcast",
        "structural_model"
      ]
    },
    "target_population": {
      "type": "object",
      "required": [
        "description",
        "entity_types",
        "inclusion_rules",
        "exclusion_rules"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "entity_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "country",
              "territory",
              "region",
              "industry",
              "firm",
              "household",
              "event"
            ]
          }
        },
        "inclusion_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "exclusion_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "additionalProperties": false
    },
    "unit_of_analysis": {
      "enum": [
        "country",
        "region",
        "industry",
        "country_time",
        "region_time",
        "industry_time",
        "event_time",
        "repeated_cross_section",
        "other"
      ]
    },
    "data_entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name_or_code",
          "entity_type",
          "code_scheme"
        ],
        "properties": {
          "name_or_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "entity_type": {
            "enum": [
              "country",
              "territory",
              "region",
              "industry",
              "custom_aggregate"
            ]
          },
          "code_scheme": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "time_scope": {
      "type": "object",
      "required": [
        "start",
        "end",
        "frequency"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 4,
          "maxLength": 32
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 4,
          "maxLength": 32
        },
        "frequency": {
          "enum": [
            "D",
            "W",
            "M",
            "Q",
            "A",
            "mixed",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "variable_id",
          "role",
          "concept",
          "definition_constraints"
        ],
        "properties": {
          "variable_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "role": {
            "enum": [
              "outcome",
              "exposure",
              "treatment",
              "shock",
              "predictor",
              "control",
              "instrument",
              "moderator",
              "forecast_target"
            ]
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "definition_constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "additionalProperties": false
      }
    },
    "intervention_or_shock": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name",
            "timing_known",
            "assignment_mechanism"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timing_known": {
              "type": "boolean"
            },
            "assignment_mechanism": {
              "enum": [
                "randomized",
                "policy_rule",
                "narrative",
                "external_instrument",
                "statistical_innovation",
                "observational",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "comparison": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1000
    },
    "forecast": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "target_variable_id",
            "horizons",
            "forecast_origin_policy",
            "point_in_time_required"
          ],
          "properties": {
            "target_variable_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            },
            "horizons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120
              }
            },
            "forecast_origin_policy": {
              "enum": [
                "rolling",
                "expanding",
                "single_origin",
                "unresolved"
              ]
            },
            "point_in_time_required": {
              "const": true
            },
            "target_vintage_policy": {
              "enum": [
                "as_released",
                "first_release",
                "fixed_vintage",
                "latest",
                "unresolved"
              ]
            },
            "temporal_split": {
              "enum": [
                "rolling",
                "expanding",
                "fixed_holdout",
                "random",
                "unresolved"
              ]
            },
            "baseline_model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "loss_function": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "response_horizons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 120
      }
    },
    "design_audit_inputs": {
      "type": "object",
      "properties": {
        "convergence_definition": {
          "enum": [
            "beta",
            "sigma",
            "catch_up",
            "unresolved"
          ]
        },
        "structural_break_evidence": {
          "enum": [
            "hypothesis",
            "formally_tested"
          ]
        },
        "price_basis_aligned": {
          "type": "boolean"
        },
        "entity_boundary_stitching": {
          "type": "boolean"
        },
        "vintage_comparison_defined": {
          "type": "boolean"
        },
        "functional_form_preregistered": {
          "type": "boolean"
        },
        "moderator_preregistered": {
          "type": "boolean"
        },
        "lagged_outcome_included": {
          "type": "boolean"
        },
        "dynamic_panel_review": {
          "type": "boolean"
        },
        "coefficient_used_as_causal_proof": {
          "type": "boolean"
        },
        "shock_identification": {
          "enum": [
            "explicit",
            "unresolved",
            "raw_policy_change"
          ]
        },
        "state_timing": {
          "enum": [
            "ex_ante",
            "unresolved"
          ]
        },
        "multiplier_definition": {
          "enum": [
            "specified",
            "unresolved"
          ]
        },
        "universal_method_claim": {
          "type": "boolean"
        },
        "treatment_defined": {
          "type": "boolean"
        },
        "comparison_group_defined": {
          "type": "boolean"
        },
        "anticipation_assessed": {
          "type": "boolean"
        },
        "spillovers_assessed": {
          "type": "boolean"
        },
        "staggered_adoption": {
          "type": "boolean"
        },
        "heterogeneity_robust_design": {
          "type": "boolean"
        },
        "parallel_trends_claimed_from_nonsignificance": {
          "type": "boolean"
        },
        "instrument_selection": {
          "enum": [
            "preregistered",
            "significance_seeking",
            "unresolved"
          ]
        },
        "synthetic_did_conditions_complete": {
          "type": "boolean"
        },
        "final_vintage_used_for_backtest": {
          "type": "boolean"
        },
        "random_temporal_split": {
          "type": "boolean"
        },
        "single_fit_metric_only": {
          "type": "boolean"
        },
        "news_decomposition_defined": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "field_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_path",
          "source",
          "evidence_text",
          "confidence"
        ],
        "properties": {
          "field_path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.\\[\\]-]{0,127}$"
          },
          "source": {
            "enum": [
              "user_provided",
              "inferred_from_text",
              "recommended_default",
              "unresolved"
            ]
          },
          "evidence_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "not_applicable"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "safe_downgrade_applied": {
      "type": "boolean"
    },
    "output_language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "intended_claim": {
            "const": "causal"
          }
        },
        "required": [
          "intended_claim"
        ]
      },
      "then": {
        "properties": {
          "intervention_or_shock": {
            "type": "object"
          },
          "variables": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "outcome"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "role": {
                      "enum": [
                        "treatment",
                        "shock",
                        "exposure"
                      ]
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intended_claim": {
            "const": "predictive"
          }
        },
        "required": [
          "intended_claim"
        ]
      },
      "then": {
        "properties": {
          "forecast": {
            "type": "object"
          },
          "variables": {
            "contains": {
              "properties": {
                "role": {
                  "const": "forecast_target"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safe_downgrade_applied": {
            "const": true
          }
        },
        "required": [
          "safe_downgrade_applied"
        ]
      },
      "then": {
        "properties": {
          "intended_claim": {
            "enum": [
              "descriptive",
              "associational"
            ]
          }
        }
      }
    }
  ]
}
