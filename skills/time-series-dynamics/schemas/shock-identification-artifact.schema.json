{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:time-series-dynamics:shock-artifact:0.1.0",
  "title": "identified shock artifact",
  "type": "object",
  "required": [
    "schema_version",
    "shock_id",
    "shock_object_type",
    "identification_strategy",
    "source_title",
    "source_version",
    "frequency",
    "units",
    "direction",
    "coverage",
    "license",
    "checksum",
    "provenance_complete",
    "review_status",
    "review_required"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "shock_id": {
      "type": "string",
      "pattern": "^shock-artifact-[a-f0-9]{16,64}$"
    },
    "shock_object_type": {"const": "observed_shock"},
    "identification_strategy": {
      "enum": [
        "narrative",
        "high_frequency",
        "external_proxy",
        "quasi_random"
      ]
    },
    "source_title": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "frequency": {"enum": ["M", "Q"]},
    "units": {"type": "string", "minLength": 1, "maxLength": 100},
    "direction": {
      "enum": ["positive_is_tightening", "positive_is_easing"]
    },
    "coverage": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 4, "maxLength": 10},
        "end": {"type": "string", "minLength": 4, "maxLength": 10}
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["identifier", "current_use_allowed"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 100},
        "current_use_allowed": {"const": true}
      },
      "additionalProperties": false
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_complete": {"const": true},
    "review_status": {"const": "approved_for_controlled_estimation"},
    "review_required": {"const": true}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"frequency": {"const": "M"}},
        "required": ["frequency"]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "start": {
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
              },
              "end": {
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"frequency": {"const": "Q"}},
        "required": ["frequency"]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "start": {"pattern": "^[0-9]{4}Q[1-4]$"},
              "end": {"pattern": "^[0-9]{4}Q[1-4]$"}
            }
          }
        }
      }
    }
  ]
}
