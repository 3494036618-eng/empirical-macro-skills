{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:time-series-dynamics:request:0.1.0",
  "title": "time-series-dynamics request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "research_plan_ref",
    "macro_data_bundle_refs",
    "analysis_track",
    "estimand_type",
    "method_profile",
    "outcome_variable_id",
    "exposure_variable_id",
    "control_variable_ids",
    "frequency",
    "sample_window",
    "sample_policy",
    "horizons",
    "lags",
    "hac_maxlags",
    "confidence_level",
    "claim_eligibility",
    "output_unit"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "request_id": {
      "type": "string",
      "pattern": "^tsd-request-[a-f0-9]{16,64}$"
    },
    "research_plan_ref": {
      "type": "string",
      "pattern": "^research-plan-[a-f0-9]{16,64}$"
    },
    "macro_data_bundle_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^macro-result-[a-f0-9]{16,64}$"
      }
    },
    "shock_identification_artifact_ref": {
      "type": "string",
      "pattern": "^shock-artifact-[a-f0-9]{16,64}$"
    },
    "analysis_track": {
      "enum": [
        "identified_shock_irf",
        "conditional_dynamic_association"
      ]
    },
    "estimand_type": {
      "enum": ["impulse_response", "conditional_projection_path"]
    },
    "method_profile": {
      "enum": [
        "observed_shock_linear_lp",
        "observed_policy_change_projection"
      ]
    },
    "outcome_variable_id": {"$ref": "#/$defs/variable_id"},
    "exposure_variable_id": {"$ref": "#/$defs/variable_id"},
    "control_variable_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/variable_id"}
    },
    "frequency": {"enum": ["M", "Q"]},
    "sample_window": {"$ref": "#/$defs/sample_window"},
    "sample_policy": {
      "enum": ["common_sample", "horizon_specific"]
    },
    "horizons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 121,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 120}
    },
    "lags": {"type": "integer", "minimum": 0, "maximum": 24},
    "hac_maxlags": {"type": "integer", "minimum": 0, "maximum": 120},
    "confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1.0
    },
    "claim_eligibility": {
      "enum": ["causal_candidate", "associational_only"]
    },
    "output_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "data_profile": {
      "enum": [
        "precomputed_columns",
        "canonical_long_table"
      ]
    },
    "response_scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "series_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/series_binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "variable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "sample_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(?:[0-9]{4}Q[1-4]|[0-9]{4}-(?:0[1-9]|1[0-2]))$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[0-9]{4}Q[1-4]|[0-9]{4}-(?:0[1-9]|1[0-2]))$"
        }
      },
      "additionalProperties": false
    },
    "series_binding": {
      "type": "object",
      "required": [
        "variable_id",
        "series_key",
        "entity_code",
        "transform"
      ],
      "properties": {
        "variable_id": {
          "$ref": "#/$defs/variable_id"
        },
        "series_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "entity_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "transform": {
          "enum": [
            "identity",
            "log",
            "difference",
            "log_difference"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"frequency": {"const": "M"}},
        "required": ["frequency"]
      },
      "then": {
        "properties": {
          "sample_window": {
            "properties": {
              "start": {
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
              },
              "end": {
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"frequency": {"const": "Q"}},
        "required": ["frequency"]
      },
      "then": {
        "properties": {
          "sample_window": {
            "properties": {
              "start": {"pattern": "^[0-9]{4}Q[1-4]$"},
              "end": {"pattern": "^[0-9]{4}Q[1-4]$"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"analysis_track": {"const": "identified_shock_irf"}},
        "required": ["analysis_track"]
      },
      "then": {
        "required": ["shock_identification_artifact_ref"],
        "properties": {
          "estimand_type": {"const": "impulse_response"},
          "method_profile": {"const": "observed_shock_linear_lp"},
          "claim_eligibility": {"const": "causal_candidate"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_track": {"const": "conditional_dynamic_association"}
        },
        "required": ["analysis_track"]
      },
      "then": {
        "not": {"required": ["shock_identification_artifact_ref"]},
        "properties": {
          "estimand_type": {"const": "conditional_projection_path"},
          "method_profile": {"const": "observed_policy_change_projection"},
          "claim_eligibility": {"const": "associational_only"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_profile": {
            "const": "canonical_long_table"
          }
        },
        "required": [
          "data_profile"
        ]
      },
      "then": {
        "required": [
          "response_scale",
          "series_bindings"
        ]
      }
    }
  ]
}
