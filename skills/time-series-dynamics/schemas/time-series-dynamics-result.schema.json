{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:time-series-dynamics:result:0.1.0",
  "title": "time-series-dynamics result",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "frequency",
    "analysis_track",
    "estimand_type",
    "claim_eligibility",
    "review_required",
    "causal_language_allowed",
    "execution_status",
    "interval_scope",
    "horizon_results"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "result_id": {
      "type": "string",
      "pattern": "^tsd-result-[a-f0-9]{16,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^tsd-request-[a-f0-9]{16,64}$"
    },
    "frequency": {
      "enum": ["M", "Q"]
    },
    "analysis_track": {
      "enum": [
        "identified_shock_irf",
        "conditional_dynamic_association"
      ]
    },
    "estimand_type": {
      "enum": ["impulse_response", "conditional_projection_path"]
    },
    "claim_eligibility": {
      "enum": ["causal_candidate", "associational_only"]
    },
    "review_required": {"type": "boolean"},
    "causal_language_allowed": {"type": "boolean"},
    "execution_status": {"enum": ["success", "partial", "failed"]},
    "interval_scope": {"const": "pointwise"},
    "horizon_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/horizon_result"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "horizon_result": {
      "type": "object",
      "required": [
        "horizon",
        "estimate",
        "standard_error",
        "confidence_level",
        "confidence_lower",
        "confidence_upper",
        "nobs",
        "df_resid"
      ],
      "properties": {
        "horizon": {"type": "integer", "minimum": 0, "maximum": 120},
        "estimate": {"type": "number"},
        "standard_error": {"type": "number", "minimum": 0},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "confidence_lower": {"type": "number"},
        "confidence_upper": {"type": "number"},
        "nobs": {"type": "integer", "minimum": 1},
        "df_resid": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"analysis_track": {"const": "identified_shock_irf"}},
        "required": ["analysis_track"]
      },
      "then": {
        "properties": {
          "estimand_type": {"const": "impulse_response"},
          "claim_eligibility": {"const": "causal_candidate"},
          "review_required": {"const": true},
          "causal_language_allowed": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_track": {"const": "conditional_dynamic_association"}
        },
        "required": ["analysis_track"]
      },
      "then": {
        "properties": {
          "estimand_type": {"const": "conditional_projection_path"},
          "claim_eligibility": {"const": "associational_only"},
          "review_required": {"const": false},
          "causal_language_allowed": {"const": false}
        }
      }
    }
  ]
}
