{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:empirical-macro:time-series-dynamics:research-plan-handoff:0.1.0",
  "title": "research-design to time-series-dynamics handoff",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "research_family",
    "intended_claim",
    "analysis_track",
    "primary_design",
    "claim_eligibility",
    "design_readiness",
    "review_required"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^research-plan-[a-f0-9]{16,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^rd-request-[a-f0-9]{16,64}$"
    },
    "research_family": {
      "const": "dynamic_shock_response"
    },
    "intended_claim": {
      "enum": [
        "associational",
        "causal"
      ]
    },
    "analysis_track": {
      "enum": [
        "identified_shock_irf",
        "conditional_dynamic_association"
      ]
    },
    "primary_design": {
      "enum": [
        "local_projection",
        "conditional_projection"
      ]
    },
    "claim_eligibility": {
      "enum": [
        "causal_candidate",
        "associational_only"
      ]
    },
    "design_readiness": {
      "enum": [
        "ready_for_data",
        "review_required"
      ]
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "intended_claim": {
          "const": "causal"
        },
        "analysis_track": {
          "const": "identified_shock_irf"
        },
        "primary_design": {
          "const": "local_projection"
        },
        "claim_eligibility": {
          "const": "causal_candidate"
        },
        "design_readiness": {
          "const": "review_required"
        },
        "review_required": {
          "const": true
        }
      },
      "required": [
        "intended_claim",
        "analysis_track",
        "primary_design",
        "claim_eligibility",
        "design_readiness",
        "review_required"
      ]
    },
    {
      "properties": {
        "intended_claim": {
          "const": "associational"
        },
        "analysis_track": {
          "const": "conditional_dynamic_association"
        },
        "primary_design": {
          "const": "conditional_projection"
        },
        "claim_eligibility": {
          "const": "associational_only"
        },
        "design_readiness": {
          "const": "ready_for_data"
        },
        "review_required": {
          "const": false
        }
      },
      "required": [
        "intended_claim",
        "analysis_track",
        "primary_design",
        "claim_eligibility",
        "design_readiness",
        "review_required"
      ]
    }
  ]
}
